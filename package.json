{
  "name": "express-typescript-template",
  "version": "1.0.0",
  "description": "Next.js-like file-based routing with Express backend - 100% TypeScript",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/generate-routes.ts && tsx watch src/server.ts",
    "build": "tsx scripts/generate-routes.ts && tsc --noEmit && tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "routes:generate": "tsx scripts/generate-routes.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
